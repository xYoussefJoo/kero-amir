# Server-side only. Base URL of the .NET API (no trailing slash). Required on Vercel: https://kero-amir.runasp.net
API_URL=http://localhost:5080

# Public origin of the site (canonical / hreflang / Open Graph URLs). On Vercel it defaults to the production domain;
# set it once a custom domain is connected.
SITE_URL=http://localhost:3000

# Shared with the API (Forwarding:Secret) so public forms are rate-limited per visitor. Required on Vercel:
# the value deploy/deploy.ps1 saves as forwardingSecret in deploy/production.secrets.json.
FORWARDING_SECRET=
