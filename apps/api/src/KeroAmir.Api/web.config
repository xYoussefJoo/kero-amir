<?xml version="1.0" encoding="utf-8"?>
<!-- Publish merges the aspNetCore handler into this file. Here: hide the IIS/ASP.NET banners. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
